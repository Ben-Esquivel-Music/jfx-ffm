+package test.com.sun.javafx.font;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+import org.junit.jupiter.api.condition.EnabledOnOs;
+import org.junit.jupiter.api.condition.OS;
+import test.com.sun.javafx.font.FontGoldenHarness.Corpus;
+import test.com.sun.javafx.font.FontGoldenHarness.GoldenMap;
+
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+/**
+ * Evidence tooling of US-067, not part of the story: writes what the five macOS golden corpora produce on this
+ * machine to the directory named by {@code -Dus067.dump}, so that a dump taken before the story's fixes can be
+ * compared with one taken after them where no golden compares. Skipped unless that property is set. The owner
+ * removes this file before committing the story.
+ */
+@EnabledOnOs(OS.MAC)
+public class Us067CorpusDumpTest {
+
+    static final String DIRECTORY_PROPERTY = "us067.dump";
+
+    @Test
+    @Timeout(600)
+    void dumpsTheFiveGoldenCorpora() throws Exception {
+        String directory = System.getProperty(DIRECTORY_PROPERTY);
+        assumeTrue(directory != null, "no dump was asked for with -D" + DIRECTORY_PROPERTY + "=<directory>");
+        Path target = Files.createDirectories(Path.of(directory));
+        Map<String, Corpus> corpora = new LinkedHashMap<>();
+        corpora.put("MacCoreTextGoldenTest", MacCoreTextGoldenTest::capture);
+        corpora.put("MacFontFinderGoldenTest", MacFontFinderGoldenTest::capture);
+        corpora.put("MacDFontGoldenTest", MacDFontGoldenTest::capture);
+        corpora.put("MacFontProcessGoldenTest", MacFontProcessGoldenTest::capture);
+        corpora.put("MacGlyphLayoutGoldenTest", MacGlyphLayoutGoldenTest::capture);
+        for (Map.Entry<String, Corpus> corpus : corpora.entrySet()) {
+            Files.writeString(target.resolve(corpus.getKey() + ".txt"), dump(corpus.getKey(), corpus.getValue()),
+                              StandardCharsets.UTF_8);
+        }
+    }
+
+    private static String dump(String name, Corpus corpus) {
+        try {
+            GoldenMap out = new GoldenMap();
+            corpus.capture(out);
+            return FontGoldens.format(out, List.of(name));
+        } catch (Exception | AssertionError e) {
+            return "FAILED " + e + "\n";
+        }
+    }
+}
