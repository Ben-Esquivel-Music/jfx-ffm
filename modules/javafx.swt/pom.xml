<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx</artifactId>
        <version>28-ea</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>javafx-swt</artifactId>
    <name>javafx-swt</name>
    <description>JavaFX SWT interop (automatic module javafx.swt)</description>

    <properties>
        <!-- FXCanvas compiles as an automatic module: base and graphics classes go on
             the module path (not the classpath) with targeted add-exports options,
             exactly as the Gradle build did. The provided-scope deps below only order
             the reactor; default-compile is replaced by the antrun javac. -->
        <maven.main.skip>true</maven.main.skip>
        <!-- Gradle parity: the SWT interop tests were always compiled and only their
             execution was gated on FULL_TEST. Using maven.test.skip here also skipped
             test compilation and left no way to opt in, so the tests were unreachable;
             skipTests is lifted by the full-test profile below (-DFULL_TEST=true). -->
        <jfx.swt.tests.skip>true</jfx.swt.tests.skip>
        <!-- Extra JVM arguments for the Gradle swt test task, supplied by the
             swt-macosx profile below -->
        <jfx.swt.test.args/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>${jfx.swt.artifact}</artifactId>
            <version>${swt.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-swt-jar</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <!-- Gradle parity: the SWT jar was copied under the fixed,
                                 platform-neutral name swt-debug.jar "for the sake of the
                                 IDEs", because the real artifact name is per-platform and
                                 an Eclipse .classpath lib entry cannot use a wildcard. -->
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>${jfx.swt.artifact}</artifactId>
                                    <version>${swt.version}</version>
                                    <type>jar</type>
                                    <destFileName>swt-debug.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/swt-libs</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-swt</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.outputDirectory}"/>
                                <javac destdir="${project.build.outputDirectory}" includeantruntime="false"
                                       encoding="UTF-8" debug="true" release="${jfx.jdk.target.version}"
                                       fork="true" sourcepath="">
                                    <src path="${project.basedir}/src/main/java"/>
                                    <classpath>
                                        <fileset dir="${project.build.directory}/swt-libs" includes="swt-debug.jar"/>
                                    </classpath>
                                    <compilerarg value="--module-path"/>
                                    <compilerarg value="${jfx.root}/modules/javafx.base/target/classes${path.separator}${jfx.root}/modules/javafx.graphics/target/classes"/>
                                    <compilerarg value="--add-modules=javafx.base,javafx.graphics"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.javafx.cursor=ALL-UNNAMED"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.javafx.embed=ALL-UNNAMED"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.javafx.tk=ALL-UNNAMED"/>
                                    <compilerarg value="${jfx.lint}"/>
                                    <compilerarg value="${jfx.werror}"/>
                                </javac>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${jfx.swt.tests.skip}</skipTests>
                    <!-- javafx.swt is an automatic module: FXCanvas (target/classes),
                         the SWT jar and the tests all stay on the classpath, while
                         javafx.base and javafx.graphics come from the shim dirs on the
                         upgrade module path, as in the other module poms. The internal
                         packages FXCanvas uses must be exported to the unnamed module;
                         the Gradle build got them from the shim module-info. -->
                    <argLine>
                        --upgrade-module-path "${jfx.shims.base}${path.separator}${jfx.shims.graphics}"
                        --add-modules javafx.base,javafx.graphics
                        --add-exports=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
                        --add-exports=javafx.graphics/com.sun.javafx.cursor=ALL-UNNAMED
                        --add-exports=javafx.graphics/com.sun.javafx.embed=ALL-UNNAMED
                        --add-exports=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED
                        --add-exports=javafx.graphics/com.sun.javafx.tk=ALL-UNNAMED
                        @${jfx.root}/buildtools/addExports
                        --enable-native-access=javafx.graphics
                        -Djava.library.path=${jfx.root}/modules/javafx.graphics/target/native/bin
                        ${jfx.swt.test.args}
                    </argLine>
                    <systemPropertyVariables>
                        <junit.jupiter.execution.timeout.test.method.default>${junit.test.timeout}s</junit.jupiter.execution.timeout.test.method.default>
                        <junit.jupiter.execution.timeout.lifecycle.method.default>${junit.lifecycle.timeout}s</junit.jupiter.execution.timeout.lifecycle.method.default>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Gradle parity: test.enabled = IS_FULL_TEST -->
            <id>full-test</id>
            <activation>
                <property>
                    <name>FULL_TEST</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <jfx.swt.tests.skip>false</jfx.swt.tests.skip>
            </properties>
        </profile>
        <profile>
            <!-- Gradle parity: environment "GDK_BACKEND", "x11" on Linux. Declared
                 here rather than in the unconditional surefire configuration so that
                 GDK_BACKEND is never handed to the forked JVM on the other platforms. -->
            <id>swt-linux</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <environmentVariables>
                                <GDK_BACKEND>x11</GDK_BACKEND>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Gradle parity: jvmArgs "-XstartOnFirstThread" on macOS -->
            <id>swt-macosx</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
            </activation>
            <properties>
                <jfx.swt.test.args>-XstartOnFirstThread</jfx.swt.test.args>
            </properties>
        </profile>
    </profiles>
</project>
